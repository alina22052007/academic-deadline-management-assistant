# Academic Deadline Management Assistant Configuration Template
# Copy this file to .env and insert your real Gemini API key.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Automation & Email (Optional SMTP - falls back to local outbox/*.eml if left blank)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
STUDENT_EMAIL=student@university.edu

